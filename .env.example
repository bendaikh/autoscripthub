APP_NAME=ESIPRES
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://esipres.com

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Dedicated database for https://esipres.com. Never use the auto-script-hub.com database.
DB_DATABASE=esipres
DB_USERNAME=
DB_PASSWORD=

# physical on this branch. digital keeps the original download marketplace.
STORE_MODE=physical
STORE_NAME=ESIPRES
STORE_URL=https://esipres.com
STORE_SUPPORT_EMAIL=support@esipres.com
STORE_ADMIN_EMAIL=
STORE_CURRENCY=USD
STORE_DEFAULT_PAYMENT=stripe
STORE_STRIPE_ENABLED=true
# Live charges stay off until these are true, APP_ENV=production, and credentials are set.
STRIPE_CHARGES_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_ENABLED=true
PAYPAL_CHARGES_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Set true in the production env so boot refuses homestead/laravel/empty database names.
STORE_ENFORCE_DATABASE=false
STORE_FORBIDDEN_DATABASES=autoscripthub,auto_script_hub,auto-script-hub
STORE_SHIPPING_FLAT_FEE=0
STORE_FREE_SHIPPING_OVER=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
