# Deployment env for the physical store at https://esipres.com.
# Copy to .env on the esipres host only. Do not use this file on auto-script-hub.com.
# Do not commit the filled-in .env. Leave secrets empty here.

APP_NAME=ESIPRES
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://esipres.com

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=esipres
DB_USERNAME=
DB_PASSWORD=

STORE_MODE=physical
STORE_NAME=ESIPRES
STORE_URL=https://esipres.com
STORE_SUPPORT_EMAIL=support@esipres.com
STORE_ADMIN_EMAIL=
STORE_CURRENCY=USD
STORE_DEFAULT_PAYMENT=stripe
STORE_STRIPE_ENABLED=true
STRIPE_CHARGES_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_ENABLED=true
PAYPAL_CHARGES_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
STORE_ENFORCE_DATABASE=true
STORE_FORBIDDEN_DATABASES=autoscripthub,auto_script_hub,auto-script-hub
STORE_SHIPPING_FLAT_FEE=0
STORE_FREE_SHIPPING_OVER=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@esipres.com
MAIL_FROM_NAME=ESIPRES
